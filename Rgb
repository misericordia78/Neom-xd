local function setOpen(state)
    panelOpen=state
    if state then
        panel.Visible=true
        panel.Position=UDim2.new(0.03,0,1,30)
        tween(panel,{Position=UDim2.new(0.03,0,1,-235)},0.35)
        open.Visible=false
    else
        tween(panel,{Position=UDim2.new(0.03,0,1,30)},0.3)
        open.Visible=true
        tween(open,{BackgroundColor3=color},0.2)
        task.delay(0.32,function()
            if panel.Parent and not panelOpen then
                panel.Visible=false
            end
        end)
    end
end

close.MouseButton1Click:Connect(function()
    setOpen(false)
end)
open.MouseButton1Click:Connect(function()
    setOpen(true)
end)

-- RGB Y GIRO CONTINUO
local connection
connection=RunService.RenderStepped:Connect(function(dt)
    if not gui.Parent then
        connection:Disconnect()
        return
    end

    if spinning then
        angle=(angle+spinSpeed*dt)%360
    end

    if rgb then
        hue=(hue+dt*0.22)%1
        color=Color3.fromHSV(hue,0.9,1)
    end

    if spinning or rgb then
        redraw()
        refreshColors()
        open.TextColor3=color
        openStroke.Color=color
    end
end)

redraw()
refreshColors()
