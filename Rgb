local styles = {
    "Cruz", "Punto", "Cuadrado", "X", "Diamante",
    "Doble cruz", "Cuatro puntos", "Circulo",
    "Tactica", "Estrella"
}

local function tween(obj, props, duration)
    if obj and obj.Parent then
        TweenService:Create(
            obj,
            TweenInfo.new(duration or 0.25, Enum.EasingStyle.Quint,
                Enum.EasingDirection.Out),
            props
        ):Play()
    end
end

-- Dibujo de la mira: solo esta capa gira
local function clearPieces()
    for _, p in ipairs(pieces) do p:Destroy() end
    table.clear(pieces)
end

local function part(w, h, x, y, rot, round)
    local a = math.rad(angle)
    local rx = x * math.cos(a) - y * math.sin(a)
    local ry = x * math.sin(a) + y * math.cos(a)

    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.new(0.5, rx, 0.5, ry)
    f.Size = UDim2.fromOffset(w, h)
    f.Rotation = rot + angle
    f.BackgroundColor3 = color
    f.BorderSizePixel = 0
    f.Visible = visible
    f.Parent = gui

    if round then
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(1, 0)
        c.Parent = f
    end
    table.insert(pieces, f)
end

local function bar(x, y, len, rot, thick)
    part(len, thick or thickness, x, y, rot, false)
end

local function drawStyle(name)
    local s, t, g = size, thickness, gap

    if name == "Cruz" then
        bar(0,-g-s/2,s,90); bar(0,g+s/2,s,90)
        bar(-g-s/2,0,s,0); bar(g+s/2,0,s,0)
    elseif name == "Punto" then
        part(t*2.5,t*2.5,0,0,0,true)
    elseif name == "Cuadrado" then
        local d=s+g
        bar(0,-d,s*2,0); bar(0,d,s*2,0)
        bar(-d,0,s*2,90); bar(d,0,s*2,90)
    elseif name == "X" then
        bar(0,0,s*2.2,45); bar(0,0,s*2.2,-45)
    elseif name == "Diamante" then
        local d=s+g
        bar(-d/2,-d/2,d*1.42,45)
        bar(d/2,-d/2,d*1.42,-45)
        bar(-d/2,d/2,d*1.42,-45)
        bar(d/2,d/2,d*1.42,45)
    elseif name == "Doble cruz" then
        for _,d in ipairs({g+s/2,g+s+5}) do
            local len = d == g+s/2 and s or s/2
            bar(0,-d,len,90); bar(0,d,len,90)
            bar(-d,0,len,0); bar(d,0,len,0)
        end
    elseif name == "Cuatro puntos" then
        for _,x in ipairs({-g-s/2,g+s/2}) do
            for _,y in ipairs({-g-s/2,g+s/2}) do
                part(t*2,t*2,x,y,0,true)
            end
        end
    elseif name == "Circulo" then
        for i=1,32 do
            local a=i*math.pi*2/32
            part(t*1.5,t*1.5,math.cos(a)*(s+g),
                math.sin(a)*(s+g),0,true)
        end
    elseif name == "Tactica" then
        local d=s+g
        bar(0,-d,s,90); bar(0,d,s,90)
        bar(-d,0,s,0); bar(d,0,s,0)
        part(t*2,t*2,0,0,0,true)
    elseif name == "Estrella" then
        for i=0,3 do bar(0,0,s*2,i*45) end
    end
end

local function redraw()
    clearPieces()
    for _,name in ipairs(styles) do
        if selected[name] then drawStyle(name) end
    end
end

