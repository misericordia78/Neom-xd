local color = Color3.fromRGB(0, 255, 255)
local hue = 0
local rgb = true
local spinning = false
local spinSpeed = 180
local angle = 0
local size = 8
local gap = 5
local thickness = 2
local visible = true
local selected = {Cruz = true}
local pieces = {}
local buttons = {}
