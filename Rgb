local function label(text)
    local l=Instance.new("TextLabel")
    l.Size=UDim2.fromOffset(125,36)
    l.BackgroundTransparency=1
    l.Text=text
    l.TextColor3=Color3.fromRGB(180,195,215)
    l.Font=Enum.Font.GothamBold
    l.TextSize=11
    l.TextWrapped=true
    l.Parent=scroll
end

local function button(text, callback)
    local b=Instance.new("TextButton")
    b.Size=UDim2.fromOffset(125,42)
    b.BackgroundColor3=Color3.fromRGB(27,32,46)
    b.BorderSizePixel=0
    b.Text=text
    b.TextColor3=Color3.new(1,1,1)
    b.Font=Enum.Font.GothamBold
    b.TextSize=11
    b.TextWrapped=true
    b.AutoButtonColor=false
    b.Parent=scroll

    local s=Instance.new("UIStroke")
    s.Color=color
    s.Thickness=1
    s.Parent=b

    b.MouseEnter:Connect(function()
        tween(b,{BackgroundColor3=color},0.18)
        tween(s,{Color=Color3.new(1,1,1)},0.18)
    end)
    b.MouseLeave:Connect(function()
        tween(b,{BackgroundColor3=Color3.fromRGB(27,32,46)},0.18)
        tween(s,{Color=color},0.18)
    end)
    b.MouseButton1Click:Connect(callback)
    table.insert(buttons,b)
    return b
end

local function refreshColors()
    title.TextColor3=color
    stroke.Color=color
    scroll.ScrollBarImageColor3=color
    for _,b in ipairs(buttons) do
        local s=b:FindFirstChildOfClass("UIStroke")
        if s then s.Color=color end
    end
end

